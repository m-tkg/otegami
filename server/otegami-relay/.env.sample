# Copy to `.env` (git-ignored) in this directory and fill in real values
# before running `docker compose up -d`. See docs/relay-deployment.md.

# Required. Generate with: openssl rand -base64 32
RELAY_MASTER_KEY=

# Optional — real APNs delivery (PENDING.md: no .p8 key has been issued for
# this project yet). Leave all four blank to run with ConsolePushSender
# (logs what would have been sent instead of actually sending it).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Directory (on the host) containing the .p8 file referenced by
# APNS_KEY_PATH above, e.g. if APNS_KEY_PATH=/app/secrets/AuthKey_ABC.p8
# then this should be the host directory containing AuthKey_ABC.p8.
APNS_KEY_DIR=./secrets
