# Copy to `.env` (git-ignored) in this directory and fill in real values
# before running `docker compose up -d`. See docs/relay-deployment.md.

# Required. Generate with: openssl rand -base64 32
RELAY_MASTER_KEY=

# Optional — real APNs delivery (PENDING.md: no .p8 key has been issued for
# this project yet). Leave all four blank to run with ConsolePushSender
# (logs what would have been sent instead of actually sending it).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Directory (on the host) containing the .p8 file referenced by
# APNS_KEY_PATH above, e.g. if APNS_KEY_PATH=/app/secrets/AuthKey_ABC.p8
# then this should be the host directory containing AuthKey_ABC.p8.
APNS_KEY_DIR=./secrets

# CLAUDE-SECURITY F2 (SSRF defense) — all optional, all blank by default.
# See docs/relay-deployment.md's threat model section before changing
# these.

# Shared operator secret required as `Authorization: Bearer <value>` on
# POST /v1/devices. Leave blank to keep device registration open (the
# historical behavior — no app-side support for sending this header has
# shipped yet, see HUMAN_TASKS.md/PENDING.md). When blank, the relay logs a
# warning on every unauthenticated registration.
RELAY_DEVICE_REGISTRATION_SECRET=

# Comma-separated extra IMAP ports POST /v1/watches will accept, beyond
# the default 143/993 (e.g. a port-forwarded home server on a nonstandard
# port).
RELAY_EXTRA_IMAP_PORTS=

# Set to 1 to let POST /v1/watches target loopback/link-local/private
# (RFC1918/ULA) IMAP hosts. Leave unset unless your IMAP server genuinely
# lives on a private network this relay can reach (e.g. a home Dovecot
# instance on the same LAN/Docker network) — the default rejects those
# targets to close the SSRF hole described in docs/relay-deployment.md.
RELAY_ALLOW_PRIVATE_IMAP_HOSTS=
