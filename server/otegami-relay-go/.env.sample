# Copy to `.env` (git-ignored) in this directory and fill in real values
# before running `docker compose up -d`. See docs/relay-deployment.md.

# Required. Generate with: openssl rand -base64 32
RELAY_MASTER_KEY=

# Optional real APNs delivery. Leave all four blank to log push payloads
# instead of sending them.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Host directory containing the .p8 file referenced by APNS_KEY_PATH.
APNS_KEY_DIR=./secrets

# Optional shared bearer secret required by POST /v1/devices.
RELAY_DEVICE_REGISTRATION_SECRET=

# Optional comma-separated IMAP ports accepted in addition to 143/993.
RELAY_EXTRA_IMAP_PORTS=

# Set to 1 only when the relay must connect to private-network IMAP hosts.
RELAY_ALLOW_PRIVATE_IMAP_HOSTS=

# OAuth client IDs used to exchange Gmail/Outlook refresh tokens. These
# must match the client IDs configured in the app build.
RELAY_GOOGLE_CLIENT_ID=
RELAY_MICROSOFT_CLIENT_ID=
