    },
    "統合受信トレイの未読数をアプリアイコンに表示します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the unified inbox's unread count on the app icon."
          }
        }
      }
    },
    "今すぐ終了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Now"
          }
        }
      }
