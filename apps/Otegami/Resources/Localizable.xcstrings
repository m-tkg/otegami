      }
    },
    "リレー URL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay URL"
          }
        }
      }
    },
    "https:// が必須です（ローカル開発時のみ http://localhost を使用できます）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "https:// is required (http://localhost is allowed for local development only)."
          }
        }
      }
    },
    "プッシュ通知は有効です": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push Notifications Are Enabled"
          }
        }
      }
    },
    "無効にする": {
      "localizations": {
        "en": {
          "stringUnit": {
