      "comment": "Task #173 PushWatchStatusSection row subtitle for a stopped watch, e.g. \"最終試行: 3分前\" / \"Last attempt: 3 minutes ago\" — %@ is a relative-time-formatted Date.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last attempt: %@"
          }
