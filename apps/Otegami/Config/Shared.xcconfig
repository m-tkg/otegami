// Settings shared by both platform targets. Signing-related settings live in
// Signing.xcconfig instead, so they can be overridden independently via
// Config/Local.xcconfig.

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// M6: Gmail OAuth Client ID. Empty by default (OSS: never checked into the
// repo — see PENDING.md/docs/oauth-setup.md); a builder who wants Gmail
// support sets this in the git-ignored Config/Local.xcconfig, which
// Signing.xcconfig #includes *after* this file, so their value overrides
// this empty default. `GoogleOAuthConfig` (app code) treats an empty/unset
// value as "Gmail unavailable in this build" and disables the Gmail button.
GOOGLE_OAUTH_CLIENT_ID =

// Task #116 第2段: Outlook.com/Office 365 OAuth Client ID (Azure app
// registration). Same empty-by-default/git-ignored-Local.xcconfig-override
// story as GOOGLE_OAUTH_CLIENT_ID just above — see docs/oauth-setup.md's
// Microsoft section. `MicrosoftOAuthConfig` (app code) treats an empty/
// unset value as "Outlook/Office365 unavailable in this build" and
// disables both buttons.
OTEGAMI_MICROSOFT_CLIENT_ID =

// M9: App Group (shared GRDB database container) + Keychain Access Group
// (shared account-password items), so the NotificationService Extension
// can look up an account's IMAP settings + password without the push
// payload ever carrying anything beyond accountId/uidNext (plan §7's
// privacy design). Derived from OTEGAMI_BUNDLE_ID/DEVELOPMENT_TEAM
// (Signing.xcconfig) rather than hardcoded, so a builder overriding either
// via Local.xcconfig automatically gets a consistent, non-colliding group
// id/keychain group without editing this file. `$(AppIdentifierPrefix)` is
// deliberately not used for the keychain group — it's an entitlements-only
// magic variable Swift code has no equivalent way to read at runtime, so
// composing the team id ourselves (available as a plain xcconfig variable)
// lets the same value be embedded in both the entitlements and Info.plist
// (see AppEnvironment/KeychainCredentialStore/NotificationService, which
// all read it from Info.plist).
OTEGAMI_APP_GROUP = group.$(OTEGAMI_BUNDLE_ID)
OTEGAMI_KEYCHAIN_GROUP = $(DEVELOPMENT_TEAM).$(OTEGAMI_BUNDLE_ID).shared

// Task #48 (デフォルトメールアプリ対応, docs/default-mail-app.md): opt-in
// switch for the `com.apple.developer.mail-client` entitlement, which
// Apple must specifically grant per-app before it can even be requested in
// a provisioning profile — a build that carries it unconditionally would
// fail to sign for everyone until the grant lands. Default `NO` (current
// behavior, unaffected); a builder whose grant has been approved *and* who
// has enabled the capability for this App ID in the Developer portal flips
// this to `YES` in the git-ignored Config/Local.xcconfig (see
// Local.xcconfig.sample). Only `NO`/`YES` (not e.g. `false`/`true`) are
// meaningful here — they're the two suffixes
// OTEGAMI_IOS_ENTITLEMENTS_FILE_NO/_YES below are named after.
OTEGAMI_MAIL_CLIENT_ENTITLEMENT = NO

// xcconfig has no native if/else, so this is the standard "variable
// indirection" trick: `$(OTEGAMI_IOS_ENTITLEMENTS_FILE)` first expands
// `$(OTEGAMI_MAIL_CLIENT_ENTITLEMENT)` to `YES` or `NO`, then looks up
// `OTEGAMI_IOS_ENTITLEMENTS_FILE_YES`/`_NO` with that resolved suffix.
// project.yml's `CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*]`/`[sdk=iphonesimulator*]`
// reference `$(OTEGAMI_IOS_ENTITLEMENTS_FILE)` (a macro, not a literal
// path) specifically so this file — not project.yml/the generated pbxproj
// — is what actually decides which entitlements file gets signed in,
// matching how DEVELOPMENT_TEAM/PRODUCT_BUNDLE_IDENTIFIER above are
// overridden from Local.xcconfig without touching project.yml (see that
// file's own doc comment on why: pbxproj-literal values from `settings:`
// take precedence over xcconfig and would break an xcconfig-level
// override).
OTEGAMI_IOS_ENTITLEMENTS_FILE_NO = Config/Otegami-iOS.entitlements
OTEGAMI_IOS_ENTITLEMENTS_FILE_YES = Config/Otegami-iOS-MailClient.entitlements
OTEGAMI_IOS_ENTITLEMENTS_FILE = $(OTEGAMI_IOS_ENTITLEMENTS_FILE_$(OTEGAMI_MAIL_CLIENT_ENTITLEMENT))
