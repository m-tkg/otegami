// Copy this file to Local.xcconfig (git-ignored) to override signing and
// per-developer secrets without touching Signing.xcconfig.
//
//   cp Config/Local.xcconfig.sample Config/Local.xcconfig
//
// DEVELOPMENT_TEAM = YOUR_TEAM_ID
// OTEGAMI_BUNDLE_ID = com.example.otegami
//
// Google OAuth Client ID (M6, Gmail account support). See
// docs/oauth-setup.md for how to obtain one (GCP project → OAuth consent
// screen → iOS-type OAuth client) and PENDING.md for the current status.
// Without this set, the app's "Gmail" add-account button stays disabled.
// GOOGLE_OAUTH_CLIENT_ID = your-client-id.apps.googleusercontent.com
